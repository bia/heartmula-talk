# Netlify: always revalidate the deck's code and content, so edits show up
# on the next reload instead of an old cached copy.
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.md
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# Cloudflare serves HTML without a charset; declare UTF-8 so link-preview
# crawlers (WhatsApp, iMessage) read the accented titles correctly.
/
  Content-Type: text/html; charset=utf-8
/pt
  Content-Type: text/html; charset=utf-8
/index*
  Content-Type: text/html; charset=utf-8
